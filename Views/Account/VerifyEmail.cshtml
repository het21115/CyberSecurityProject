@model VerifyRegistrationEmailViewModel
@{
    ViewData["Title"] = "Verify email";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1>Verify your email</h1>
        <p>Enter the six-digit code sent to <strong>@ViewBag.Email</strong>. The code expires in 10 minutes.</p>
        <form asp-action="VerifyEmail" method="post">
            <input asp-for="VerificationId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Otp" class="form-label">Verification code</label>
                <input asp-for="Otp" class="form-control" inputmode="numeric" autocomplete="one-time-code" maxlength="6" />
                <span asp-validation-for="Otp" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Verify and create account</button>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
